# Copy this file to pipeline_settings.yml and edit it for your environment.
#
# The step -> conda-env mapping lives in AdVentSeq/conda_tools.yml,
# as a `steps:` list on each env entry.

# Optional reference paths loaded during Pipeline object initialization.
# Define one or more reference bundles keyed by ref_genome.
# reference_paths:
#   hg38:
#     genome_fasta: /path/to/hg38/genome.fa
#     bwa_index: /path/to/hg38/bwa/index/prefix
#     bowtie2_index: /path/to/hg38/bowtie2/index/prefix
#     minimap2_index: /path/to/hg38/genome.mmi
#     hisat2_index: /path/to/hg38/hisat2/index/prefix
#     star_index: /path/to/hg38/STAR/index_dir
#     gtf: /path/to/hg38/genes.gtf
#   mm10:
#     genome_fasta: /path/to/mm10/genome.fa
#     bwa_index: /path/to/mm10/bwa/index/prefix
#     gtf: /path/to/mm10/genes.gtf
